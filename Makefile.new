CXX = g++
CXXFLAGS = -std=c++11 -Wall
TARGET = calc
SRC_DIR = src
TEST_DIR = test

# Source files
SRCS = $(SRC_DIR)/Loan.cpp $(SRC_DIR)/main.cpp
OBJS = $(SRCS:.cpp=.o)

# Default target
all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $(OBJS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(TARGET) $(OBJS) $(SRC_DIR)/*.o

test: $(TEST_DIR)/test_emi.cpp $(SRC_DIR)/Loan.cpp
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) $(TEST_DIR)/test_emi.cpp $(SRC_DIR)/Loan.cpp -lgtest -lgtest_main -pthread -o test_runner
	./test_runner

.PHONY: all clean test
